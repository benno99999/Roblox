--!strict

return function()
	local Bin = require("../src/shared/Bin")

	describe("new", function()
		it("starts empty at the given capacity", function()
			local bin = Bin.new(8)
			expect(bin.capacity).to.equal(8)
			expect(bin.amount).to.equal(0)
			expect(Bin.space(bin)).to.equal(8)
			expect(Bin.isFull(bin)).to.equal(false)
		end)

		it("accepts a starting amount inside the bin", function()
			local bin = Bin.new(8, 3)
			expect(bin.amount).to.equal(3)
			expect(Bin.space(bin)).to.equal(5)
		end)

		it("rejects a negative capacity", function()
			expect(function()
				Bin.new(-1)
			end).to.throw("capacity")
		end)

		it("rejects an amount past capacity", function()
			expect(function()
				Bin.new(4, 5)
			end).to.throw("amount")
		end)
	end)

	describe("tryAdd", function()
		it("stores dust that fits", function()
			local bin = Bin.new(8)
			expect(Bin.tryAdd(bin, 3)).to.equal(3)
			expect(bin.amount).to.equal(3)
			expect(Bin.space(bin)).to.equal(5)
		end)

		it("stores only what is left when the bin is nearly full", function()
			local bin = Bin.new(8, 6)
			expect(Bin.tryAdd(bin, 5)).to.equal(2)
			expect(bin.amount).to.equal(8)
			expect(Bin.isFull(bin)).to.equal(true)
		end)

		it("stores nothing when the bin is full", function()
			local bin = Bin.new(8, 8)
			expect(Bin.tryAdd(bin, 1)).to.equal(0)
			expect(bin.amount).to.equal(8)
		end)

		it("ignores zero and negative counts", function()
			local bin = Bin.new(8, 2)
			expect(Bin.tryAdd(bin, 0)).to.equal(0)
			expect(Bin.tryAdd(bin, -4)).to.equal(0)
			expect(bin.amount).to.equal(2)
		end)

		it("drops a fractional mote", function()
			local bin = Bin.new(8)
			expect(Bin.tryAdd(bin, 2.9)).to.equal(2)
			expect(bin.amount).to.equal(2)
		end)
	end)

	describe("empty", function()
		it("returns the contents and clears the bin", function()
			local bin = Bin.new(8, 5)
			expect(Bin.empty(bin)).to.equal(5)
			expect(bin.amount).to.equal(0)
			expect(Bin.tryAdd(bin, 1)).to.equal(1)
		end)
	end)
end
