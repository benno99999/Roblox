--!strict

return function()
	local Config = require("../src/shared/Config")
	local Upgrades = require("../src/shared/Upgrades")

	describe("bin capacity", function()
		it("starts at the base capacity", function()
			expect(Upgrades.binCapacity(0)).to.equal(Config.BASE_BIN_CAPACITY)
			expect(Upgrades.binCapacity(0)).to.equal(8)
		end)

		it("grows by a fixed step per level", function()
			expect(Upgrades.binCapacity(1)).to.equal(12)
			expect(Upgrades.binCapacity(2)).to.equal(16)
			expect(Upgrades.binCapacity(Config.MAX_BIN_LEVEL)).to.equal(40)
		end)

		it("clamps levels outside the allowed range", function()
			expect(Upgrades.binCapacity(-3)).to.equal(Config.BASE_BIN_CAPACITY)
			expect(Upgrades.binCapacity(100)).to.equal(Upgrades.binCapacity(Config.MAX_BIN_LEVEL))
		end)
	end)

	describe("cost", function()
		it("charges the base cost for the first upgrade", function()
			expect(Config.BIN_UPGRADE_BASE_COST).to.equal(16)
			expect(Upgrades.binUpgradeCost(0)).to.equal(16)
		end)

		it("charges one more step at each level", function()
			expect(Upgrades.binUpgradeCost(1)).to.equal(32)
			expect(Upgrades.binUpgradeCost(2)).to.equal(48)
		end)

		it("has no price at max level or for a nonsense level", function()
			expect(Upgrades.binUpgradeCost(Config.MAX_BIN_LEVEL)).to.equal(nil)
			expect(Upgrades.binUpgradeCost(-1)).to.equal(nil)
			expect(Upgrades.binUpgradeCost(1.5)).to.equal(nil)
		end)
	end)

	describe("tryBuyBin", function()
		it("spends coins and raises the level", function()
			local bought = Upgrades.tryBuyBin(16, 0)
			expect(bought.ok).to.equal(true)
			expect(bought.coins).to.equal(0)
			expect(bought.level).to.equal(1)
			expect(Upgrades.binCapacity(bought.level)).to.equal(12)

			local again = Upgrades.tryBuyBin(40, bought.level)
			expect(again.ok).to.equal(true)
			expect(again.coins).to.equal(8)
			expect(again.level).to.equal(2)
		end)

		it("refuses a purchase the player cannot afford", function()
			local bought = Upgrades.tryBuyBin(15, 0)
			expect(bought.ok).to.equal(false)
			expect(bought.reason).to.equal("not_enough_coins")
			expect(bought.coins).to.equal(15)
			expect(bought.level).to.equal(0)
		end)

		it("refuses a purchase at max level", function()
			local bought = Upgrades.tryBuyBin(100000, Config.MAX_BIN_LEVEL)
			expect(bought.ok).to.equal(false)
			expect(bought.reason).to.equal("max_level")
			expect(bought.level).to.equal(Config.MAX_BIN_LEVEL)
			expect(bought.coins).to.equal(100000)
		end)

		it("refuses a level that is not a real upgrade step", function()
			local bought = Upgrades.tryBuyBin(100, -2)
			expect(bought.ok).to.equal(false)
			expect(bought.reason).to.equal("invalid_level")
			expect(bought.level).to.equal(-2)
		end)
	end)
end
